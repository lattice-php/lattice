includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - packages/core/src
        - src
        - packages/core/src
        - packages/ui/src
        - tests
        - workbench/app
    excludePaths:
        - tests/Fixtures/TypeScript/Unloadable/BrokenExtendsMissingClass.php
    level: 6
