#!/bin/sh
# Fast static gate, scoped to what the push actually changes. Mirrors the local
# Verification routine in .ai/guidelines/development.md.
# Bypass with `git push --no-verify` (emergencies only — never push on red).
#
# The PHP side only runs Pint and PHPStan here — the full Pest suite and Rector are left
# to CI (and to running explicitly, e.g. `composer test`/`composer check`) because a full
# local test run on every push is too slow for a pre-push hook. The generated-types and
# docs-fixtures diffs are also intentionally left to CI: a local run regenerates the
# committed generated.ts with a different property ordering than main, so a local diff
# check would fail spuriously. Pest Browser stays CI-only because it needs the built
# workbench assets and Playwright browsers. docs:typecheck (docs/tsconfig.json)
# and the icons-freshness diff also stay CI-only for the same local-drift reasons.
#
# Each gate runs only when the push touches its side: a PHP-only push skips the JS gate
# entirely and vice versa, Vitest runs only the tests reachable from the changed files
# (module graph via --changed), and check:package runs only when a package manifest or
# build config changed. Any file the classification does not recognize — and any push
# whose diff base cannot be resolved — fails toward running both gates in full. CI always
# runs everything, so a scoped skip here is never the last line of defense.
#
# The PHP and JS gates are independent, so they run concurrently — JS logs to a
# temp file that is replayed only on failure, PHP streams live.

root="$(git rev-parse --show-toplevel)"
cd "$root"

gate_required=""
have_update=""
changed_files=""
vitest_base=""

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    have_update=1
    [ -n "$gate_required" ] && continue
    case "$remote_sha" in
        *[!0]*) base="$remote_sha" ;;
        *) base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || base="" ;;
    esac
    if [ -z "$base" ]; then
        gate_required=1
        continue
    fi
    if files="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"; then
        changed_files="$changed_files$files
"
    else
        gate_required=1
        continue
    fi
    if [ -z "$vitest_base" ]; then
        vitest_base="$base"
    elif [ "$vitest_base" != "$base" ]; then
        gate_required=1
    fi
done

if [ -z "$have_update" ]; then
    echo "✓ pre-push: deletions only, nothing to verify"
    exit 0
fi

php_gate=""
js_gate=""
js_full=""
pkg_check=""

if [ -n "$gate_required" ]; then
    php_gate=1
    js_gate=1
    js_full=1
else
    IFS='
'
    for f in $changed_files; do
        case "$f" in
            *.md | *.mdx | .github/* | .githooks/*) ;;
            *.php | *composer.json | composer.lock | phpstan*.neon* | pint.json | rector.php) php_gate=1 ;;
            *package.json | package-lock.json | *vite.config.*) js_gate=1 pkg_check=1 ;;
            *.ts | *.tsx | *.css | *.js | *.jsx | *.mjs | *.cjs | *.json | *.snap) js_gate=1 ;;
            *)
                php_gate=1
                js_gate=1
                js_full=1
                ;;
        esac
    done
    unset IFS
fi

if [ -z "$php_gate" ] && [ -z "$js_gate" ]; then
    echo "✓ pre-push: no PHP or JS changes, skipping gate"
    exit 0
fi

run_js_gate() {
    if [ -n "$js_full" ]; then
        npm run check
        return $?
    fi
    VITEST_CHANGED_BASE="$vitest_base" npm run check:push || return 1
    if [ -n "$pkg_check" ]; then
        npm run check:package || return 1
    fi
}

js_status=0
js_pid=""
js_log=""

if [ -n "$js_gate" ]; then
    js_log="$(mktemp)"
    trap 'rm -f "$js_log"' EXIT
    run_js_gate >"$js_log" 2>&1 &
    js_pid=$!
fi

php_status=0
if [ -n "$php_gate" ]; then
    [ -n "$js_gate" ] && concurrent=" + JS gate (concurrent)" || concurrent=""
    echo "▶ pre-push: PHP gate (pint + phpstan)$concurrent"
    vendor/bin/pint --parallel --test && vendor/bin/phpstan analyse && vendor/bin/phpstan analyse -c phpstan-tests.neon.dist
    php_status=$?
elif [ -n "$js_gate" ]; then
    echo "▶ pre-push: JS gate only (no PHP changes)"
fi

if [ -n "$js_pid" ]; then
    wait "$js_pid"
    js_status=$?
    if [ "$js_status" -ne 0 ]; then
        echo "✗ JS gate failed:"
        cat "$js_log"
    fi
fi

if [ "$php_status" -ne 0 ] || [ "$js_status" -ne 0 ]; then
    exit 1
fi

echo "✓ pre-push gate passed"
