{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lattice-php/core",
    "description": "Core contracts, discovery, evaluation, and serialization for Lattice.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "spatie/php-attribute-reader": "^1.1",
        "spatie/php-structure-discoverer": "^2.4",
        "symfony/type-info": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Lattice\\Core\\": "src/"
        }
    },
    "extra": {
        "lattice": {
            "discover": ["src"]
        },
        "laravel": {
            "providers": [
                "Lattice\\Core\\CoreServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
