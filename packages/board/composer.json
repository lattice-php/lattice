{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lattice-php/board",
    "description": "Kanban-style board component with configurable columns and per-column paging for Lattice.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "lattice-php/action": "self.version",
        "lattice-php/core": "self.version",
        "lattice-php/form": "self.version",
        "lattice-php/table": "self.version",
        "lattice-php/ui": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Lattice\\Board\\": "src/"
        }
    },
    "extra": {
        "lattice": {
            "plugin": "resources/js/plugin.ts",
            "standalone": "dist/plugin.js",
            "css": "resources/css/board.css",
            "discover": ["src"]
        },
        "laravel": {
            "providers": [
                "Lattice\\Board\\BoardServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
