{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@lattice-php/table": ["./resources/js/index.ts"],
      "@lattice-php/table/*": ["./resources/js/*"],
      "@lattice-php/form": ["../form/dist/index.d.ts"],
      "@lattice-php/form/*": ["../form/dist/*"],
      "@lattice-php/ui": ["../ui/dist/index.d.ts"],
      "@lattice-php/ui/*": ["../ui/dist/*"]
    }
  },
  "include": ["resources/js"],
  "exclude": ["resources/js/**/*.test.*", "resources/js/**/*.test-d.*"]
}
