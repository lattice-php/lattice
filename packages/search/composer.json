{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lattice-php/search",
    "description": "Global application search with provider discovery and a command-menu interface for Lattice.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^11.0 || ^12.0 || ^13.0",
        "lattice-php/core": "self.version",
        "lattice-php/ui": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Lattice\\Search\\": "src/"
        }
    },
    "extra": {
        "lattice": {
            "plugin": "resources/js/plugin.ts",
            "standalone": "dist/plugin.js",
            "css": "resources/css/search.css",
            "icons": "resources/icons",
            "discover": ["src"]
        },
        "laravel": {
            "providers": [
                "Lattice\\Search\\SearchServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
