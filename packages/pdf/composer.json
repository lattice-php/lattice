{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lattice-php/pdf",
    "description": "A pdf.js based document viewer with search, zoom, and text selection for Lattice.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/config": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "lattice-php/core": "self.version",
        "lattice-php/ui": "self.version"
    },
    "suggest": {
        "lattice-php/media": "Source viewer documents from media attachments with PdfViewer::media()."
    },
    "autoload": {
        "psr-4": {
            "Lattice\\Pdf\\": "src/"
        }
    },
    "extra": {
        "lattice": {
            "plugin": "resources/js/plugin.composer.ts",
            "standalone": "dist/plugin.js",
            "css": "resources/css/pdf.css",
            "icons": "resources/icons",
            "discover": ["src"]
        },
        "laravel": {
            "providers": [
                "Lattice\\Pdf\\PdfServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
