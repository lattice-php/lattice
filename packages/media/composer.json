{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lattice-php/media",
    "description": "Media library and picker components for Lattice.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.0",
        "lattice-php/action": "self.version",
        "lattice-php/core": "self.version",
        "lattice-php/form": "self.version",
        "lattice-php/table": "self.version",
        "lattice-php/ui": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Lattice\\Media\\": "src/",
            "Lattice\\Media\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "lattice": {
            "discover": [
                "src"
            ],
            "plugin": "resources/js/plugin.ts",
            "standalone": "dist/plugin.js"
        },
        "laravel": {
            "providers": [
                "Lattice\\Media\\MediaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
